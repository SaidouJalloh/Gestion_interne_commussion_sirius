model contrats {
  id                     String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id        String           @db.Uuid
  client_id              String           @db.Uuid
  compagnie_id           String           @db.Uuid
  type_contrat           String           @db.VarChar(100)
  prime_nette            Decimal          @db.Decimal(12, 2)
  montant_accessoire     Decimal?         @default(0) @db.Decimal(12, 2)
  taux_commission        Decimal          @db.Decimal(5, 4)
  commission             Decimal          @db.Decimal(12, 2)
  date_effet             DateTime         @db.Date
  date_expiration        DateTime         @db.Date
  statut                 String?          @default("actif") @db.VarChar(20)
  fractionnement         String?          @default("annuel") @db.VarChar(20)
  notes                  String?
  created_at             DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at             DateTime?        @default(now()) @db.Timestamptz(6)
  evacuation_sanitaire   Decimal?         @db.Decimal
  prime_regulation       Decimal?         @db.Decimal
  immatriculation        String?
  prime_ttc              Decimal?         @default(0) @db.Decimal
  fga                    Decimal?         @default(0) @db.Decimal
  taxes                  Decimal?         @default(0) @db.Decimal
  is_flotte              Boolean?         @default(false)
  prime_ttc_initial      Decimal?         @db.Decimal(12, 2)
  montant_incorporations Decimal?         @default(0) @db.Decimal(12, 2)
  nombre_incorporations  Int?             @default(0)
  clients                clients          @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  compagnies             compagnies       @relation(fields: [compagnie_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organizations          organizations    @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  dossiers               dossiers[]
  incorporations         incorporations[]
  medias                 medias[]
  notifications          notifications[]
  paiements              paiements[]
  sinistres              sinistres[]
  vehicules              vehicules[]

  @@index([client_id, created_at(sort: Desc)], map: "idx_contrats_client_created")
  @@index([client_id], map: "idx_contrats_client_id")
  @@index([client_id, statut], map: "idx_contrats_client_statut")
  @@index([compagnie_id], map: "idx_contrats_compagnie_id")
  @@index([compagnie_id, type_contrat], map: "idx_contrats_compagnie_type")
  @@index([created_at(sort: Desc)], map: "idx_contrats_created_at")
  @@index([date_effet(sort: Desc)], map: "idx_contrats_date_effet")
  @@index([date_expiration], map: "idx_contrats_date_expiration")
  @@index([fractionnement], map: "idx_contrats_fractionnement")
  @@index([statut], map: "idx_contrats_statut")
  @@index([statut, date_expiration], map: "idx_contrats_statut_date")
  @@index([statut, date_effet(sort: Desc)], map: "idx_contrats_statut_date_effet")
  @@index([type_contrat], map: "idx_contrats_type_contrat")
  @@index([type_contrat, statut], map: "idx_contrats_type_statut")
  @@index([updated_at(sort: Desc)], map: "idx_contrats_updated_at")
  @@index([organization_id], map: "idx_contrats_organization_id")
  @@schema("public")
}

