    notes                  String?
    created_at             DateTime?        @default(now()) @db.Timestamptz(6)
    updated_at             DateTime?        @default(now()) @db.Timestamptz(6)
    evacuation_sanitaire   Decimal?         @db.Decimal
    prime_regulation       Decimal?         @db.Decimal
    immatriculation        String?
    prime_ttc              Decimal?         @default(0) @db.Decimal
