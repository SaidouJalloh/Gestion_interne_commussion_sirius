# Global ignore for backend & frontend

# Node dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Builds / distributions
dist/
build/
coverage/
*.tsbuildinfo

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Backend-specific (safety, redondant avec backend/.gitignore)
backend/node_modules/
backend/dist/
backend/coverage/

# Frontend-specific
frontend/node_modules/
frontend/build/
frontend/dist/
frontend/coverage/


