    "item": [
        {
            "name": "1. Authentification",
            "item": [
                {
                    "name": "Login - Super Admin",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    const jsonData = pm.response.json();",
                                    "    // Supabase retourne access_token directement",
                                    "    if (jsonData.access_token) {",
                                    "        pm.environment.set(\"access_token\", jsonData.access_token);",
                                    "    }",
                                    "    // Ou dans session.access_token",
                                    "    if (jsonData.session && jsonData.session.access_token) {",
                                    "        pm.environment.set(\"access_token\", jsonData.session.access_token);",
                                    "    }",
                                    "    // User ID",
                                    "    if (jsonData.user && jsonData.user.id) {",
                                    "        pm.environment.set(\"user_id\", jsonData.user.id);",
                                    "    }",
                                    "    if (jsonData.session && jsonData.session.user && jsonData.session.user.id) {",
                                    "        pm.environment.set(\"user_id\", jsonData.session.user.id);",
                                    "    }",
                                    "}",
                                    "",
                                    "pm.test(\"Status code is 200\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "pm.test(\"Response has access_token\", function () {",
                                    "    const jsonData = pm.response.json();",
                                    "    const hasToken = jsonData.access_token || (jsonData.session && jsonData.session.access_token);",
                                    "    pm.expect(hasToken).to.be.truthy;",
                                    "});",
                                    "",
                                    "pm.test(\"Token saved to environment\", function () {",
                                    "    const token = pm.environment.get(\"access_token\");",
                                    "    pm.expect(token).to.not.be.empty;",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "apikey",
                                "value": "{{supabase_anon_key}}",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"superadmin@gmail.com\",\n    \"password\": \"Imamsaid@95\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/auth/v1/token?grant_type=password",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "v1",
                                "token"
                            ],
                            "query": [
                                {
                                    "key": "grant_type",
                                    "value": "password"
                                }
                            ]
                        },
                        "description": "Connexion avec le compte super admin pour obtenir le token d'authentification.\n\n⚠️ IMPORTANT:\n1. Sélectionner l'environnement 'Sirius Multi-Tenant - Local' dans le dropdown en haut à droite\n2. Configurer les variables base_url et supabase_anon_key dans l'environnement\n\n📝 Identifiants :\n- Email: superadmin@gmail.com\n- Password: Imamsaid@95"
                    },
                    "response": []
                },
                {
                    "name": "Login - Admin",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    const jsonData = pm.response.json();",
                                    "    if (jsonData.access_token) {",
                                    "        pm.environment.set(\"access_token_admin\", jsonData.access_token);",
                                    "        pm.environment.set(\"user_id_admin\", jsonData.user.id);",
                                    "    }",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "apikey",
                                "value": "{{supabase_anon_key}}",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"admin@gmail.com\",\n    \"password\": \"Admin123!\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/auth/v1/token?grant_type=password",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "v1",
                                "token"
                            ],
                            "query": [
                                {
                                    "key": "grant_type",
                                    "value": "password"
                                }
                            ]
                        },
                        "description": "Connexion avec le compte admin"
                    },
                    "response": []
                }
            ]
        },
