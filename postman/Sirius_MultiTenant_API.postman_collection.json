{
    "info": {
        "_postman_id": "sirius-multitenant-api",
        "name": "Sirius Multi-Tenant API",
        "description": "Collection de tests pour l'API multi-tenant Sirius Assurance",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
