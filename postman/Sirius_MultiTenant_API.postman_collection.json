            "name": "2. Organisations",
            "item": [
                {
                    "name": "Créer une organisation",
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "exec": [
                                    "// Vérifier que le token existe",
                                    "const token = pm.environment.get(\"access_token\");",
                                    "if (!token) {",
                                    "    console.error(\"❌ ERREUR: access_token non trouvé dans l'environnement\");",
                                    "    console.error(\"⚠️ Vous devez d'abord exécuter la requête 'Login - Super Admin'\");",
                                    "    throw new Error(\"Token d'authentification manquant. Exécutez d'abord 'Login - Super Admin'.\");",
                                    "}",
                                    "console.log(\"✅ Token trouvé, requête prête à être envoyée\");"
                                ],
                                "type": "text/javascript"
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 201) {",
                                    "    const jsonData = pm.response.json();",
                                    "    if (jsonData.success && jsonData.data) {",
                                    "        pm.environment.set(\"org_a_id\", jsonData.data.id);",
                                    "        pm.environment.set(\"org_a_slug\", jsonData.data.slug);",
                                    "    }",
                                    "}",
                                    "",
                                    "pm.test(\"Status code is 201\", function () {",
                                    "    pm.response.to.have.status(201);",
                                    "});",
                                    "",
                                    "pm.test(\"Response has success true\", function () {",
                                    "    const jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.success).to.be.true;",
                                    "});",
                                    "",
                                    "pm.test(\"Organization created with correct name\", function () {",
                                    "    const jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.data.name).to.eql(\"Organisation A\");",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{access_token}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"name\": \"Organisation A\",\n    \"slug\": \"org-a-{{$timestamp}}\"\n}"
                        },
                        "url": {
                            "raw": "{{api_url}}/organizations",
                            "host": [
                                "{{api_url}}"
                            ],
                            "path": [
                                "organizations"
                            ]
                        },
                        "description": "Créer une nouvelle organisation.\n\n⚠️ IMPORTANT:\n1. Vous devez d'abord exécuter 'Login - Super Admin' pour obtenir le token\n2. Le token sera automatiquement inclus dans le header Authorization\n3. Cette route ne nécessite pas d'organisation active (c'est la création de la première organisation)"
                    }
