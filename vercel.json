{
    "version": 2,
    "buildCommand": "npm run build",
    "outputDirectory": "build",
    "framework": "create-react-app",
    "headers": [
        {
            "source": "/static/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/(.*\\.(png|jpg|jpeg|gif|svg|ico|webp|json))",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/((?!static/|favicon\\.ico|logo.*\\.png|manifest\\.json|robots\\.txt|.*\\.(png|jpg|jpeg|gif|svg|ico|webp|json|woff|woff2|ttf|eot)).*)",
            "destination": "/index.html"
        }
    ]
}